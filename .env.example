# Copy to .env and fill in. Never commit .env.
PORT=3000
PUBLIC_URL=http://localhost:3000
# 1 behind HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=0
LOG_LEVEL=info
DB_FILE=
UPLOAD_DIR=
PAY_WINDOW_HOURS=48
SUPPORT_EMAIL=support@example.com

# Seeded admin: admin@retrolot.test / this password. Demo users: user1..user48@retrolot.test / password123
ADMIN_PASSWORD=admin12345

# Email (empty = messages are only written to the log)
SMTP_URL=
MAIL_FROM=RetroLot <noreply@example.com>

# Google login (empty = button hidden). Redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
